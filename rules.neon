# Opt-in TypeBridge V2 contract-enforcement rules.
#
# NOT auto-loaded by consumers (extension.neon is). Include this only once an
# application adopts the V2 contract conventions (#[ApiResponses]/#[ApiRequest]
# on controllers, @phpstan-type _self shapes), otherwise these rules will flag
# every existing route and shape. To enable:
#
#   includes:
#       - vendor/ptgs/php-type-bridge/rules.neon
parameters:
    typeBridge:
        preserveNull: []
        shapeNaming:
            allowIdSuffix: []
        # Routing entrypoint, relative to the analysed project. Route paths are assembled from a
        # config `prefix`, an optional class-level #[Route] and the method attribute — only the
        # last of which is visible to static analysis. Point this at the real routing file and the
        # rules see the served path instead. Left null, any rule keyed on the full path (e.g.
        # "is this under /api") falls back to the method attribute alone, which in an application
        # that prefixes in routing config means those rules match nothing.
        routing: null

parametersSchema:
    typeBridge: structure([
        preserveNull: listOf(string()),
        shapeNaming: structure([
            allowIdSuffix: listOf(string())
        ]),
        routing: schema(string(), nullable())
    ])

services:
    -
        class: PTGS\TypeBridge\Routing\RoutePathResolver
        arguments:
            projectDirectory: %currentWorkingDirectory%
            routingFile: %typeBridge.routing%

    -
        class: PTGS\TypeBridge\PHPStan\Support\ApiMethodInspector

    -
        class: PTGS\TypeBridge\PHPStan\Support\FormContractValidator

    -
        class: PTGS\TypeBridge\Support\FormTypeInspector

    -
        class: PTGS\TypeBridge\Support\PhpDocTypeHelper

    -
        class: PTGS\TypeBridge\Parser\PhpDocShapeParser

    -
        class: PTGS\TypeBridge\Support\PhpDocShapeParserResolver

    -
        class: PTGS\TypeBridge\PHPStan\Rules\Controller\ApiResponsesRequiredRule
        tags:
            - phpstan.rules.rule

    -
        class: PTGS\TypeBridge\PHPStan\Rules\Controller\MutatingApiRequestRequiredRule
        tags:
            - phpstan.rules.rule

    -
        class: PTGS\TypeBridge\PHPStan\Rules\Controller\ApiResponseDeclarationRule
        tags:
            - phpstan.rules.rule

    -
        class: PTGS\TypeBridge\PHPStan\Rules\Controller\NoRequestQueryAccessRule
        tags:
            - phpstan.rules.rule

    -
        class: PTGS\TypeBridge\PHPStan\Rules\Enum\NoEnumParseOfDtoPropertyRule
        tags:
            - phpstan.rules.rule

    -
        class: PTGS\TypeBridge\PHPStan\Rules\Form\ContractFormTypeRule
        tags:
            - phpstan.rules.rule

    -
        class: PTGS\TypeBridge\PHPStan\Rules\Shape\NoIdSuffixRule
        arguments:
            allowIdSuffix: %typeBridge.shapeNaming.allowIdSuffix%
        tags:
            - phpstan.rules.rule

    -
        class: PTGS\TypeBridge\PHPStan\Rules\Shape\NoTypeIdPairRule
        tags:
            - phpstan.rules.rule

    -
        class: PTGS\TypeBridge\PHPStan\Rules\Shape\PreserveNullConsistencyRule
        arguments:
            preserveNull: %typeBridge.preserveNull%
        tags:
            - phpstan.rules.rule

    -
        class: PTGS\TypeBridge\PHPStan\Rules\Normalizer\ShapeNormalizerBatchRule
        tags:
            - phpstan.rules.rule
